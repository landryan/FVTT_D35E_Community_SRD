    "deactivateActions": [
      {
        "action": "Remove attack \"Prismatic Effect (Red)\" on self; Remove attack \"Prismatic Effect (Orange)\" on self; Remove attack \"Prismatic Effect (Yellow)\" on self; Remove attack \"Prismatic Effect (Green)\" on self; Remove attack \"Prismatic Effect (Blue)\" on self; Remove attack \"Prismatic Effect (Indigo)\" on self; Remove attack \"Prismatic Effect (Violet)\" on self;",
